# =============================================================================
# Lazarus.Proof — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -- Flow Blockchain ----------------------------------------------------------
# The address of the account that deployed LazarusGuard.cdc.
# This account holds the OracleAdmin resource.
FLOW_ORACLE_ADDRESS=32258b0c4e249730

# Private key for the Oracle account (hex-encoded, ECDSA_P256).
# Ask the contract deployer for this key. NEVER commit it.
FLOW_PRIVATE_KEY=

# Flow Access Node API (REST endpoint).
# Testnet:   https://rest-testnet.onflow.org
# Mainnet:   https://rest-mainnet.onflow.org
# Emulator:  http://localhost:8888
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org

# The address where LazarusGuard is deployed (same as FLOW_ORACLE_ADDRESS
# since the Oracle account deployed the contract).
LAZARUS_GUARD_ADDRESS=32258b0c4e249730

# -- Lighthouse (Filecoin Pinning) -------------------------------------------
# Get your API key from: https://files.lighthouse.storage
LIGHTHOUSE_API_KEY=

# -- Server -------------------------------------------------------------------
PORT=3001
NODE_ENV=development
